extends Node
# Plays every sound in the game: one-shot effects, looping music and ambience.
# The sounds are generated by tools/make_audio.py into assets/audio/.
#   Audio.sfx("hit")            play an effect
#   Audio.music("mus_town")     crossfade to a looping music track ("" stops it)
#   Audio.ambience("amb_cave")  crossfade the background ambience
# F10 mutes everything, F11 mutes only the music.

const DIR := "res://assets/audio/"
const SFX_NAMES := [
	"swing", "hit", "enemy_die", "hurt", "dash", "fireball", "boom", "coin", "buy", "click", "tick", "open",
	"close", "blip", "eat", "potion", "heal", "powerup", "levelup", "quest_accept", "quest_done", "chest",
	"prize", "roar", "boss_defeat", "bolt", "door", "chop", "mine", "cast", "bite", "reel", "splash",
	"catch_common", "catch_uncommon", "catch_rare", "catch_epic", "catch_legendary", "shoot", "target_hit",
	"bullseye", "gold_target", "miss", "pet", "night", "dawn", "sizzle", "cook_done", "freeze", "slam",
	"ice_shatter", "victory",
]
const MUSIC_NAMES := ["mus_farm", "mus_town", "mus_interior", "mus_night", "mus_cave", "mus_boss", "mus_frost"]
const AMBIENCE_NAMES := ["amb_birds", "amb_crickets", "amb_wind", "amb_cave"]

# Per-sound loudness in dB, since some effects are naturally louder than others.
const GAIN := {
	"blip": -7.0, "tick": -9.0, "click": -4.0, "swing": -5.0, "hit": -3.0, "boom": -2.0, "roar": 0.0,
	"coin": -5.0, "buy": -4.0, "open": -6.0, "close": -6.0, "night": -6.0, "dawn": -6.0, "slam": 0.0,
	"levelup": -2.0, "prize": -1.0, "victory": -1.0, "boss_defeat": -1.0,
}
const MUSIC_DB := -11.0
const AMBIENCE_DB := -14.0
const SFX_DB := -2.0
const POOL_SIZE := 14
const FADE := 1.2

var streams := {}
var pool: Array[AudioStreamPlayer] = []
var music_players: Array[AudioStreamPlayer] = []
var ambience_player := AudioStreamPlayer.new()
var current_music := ""
var current_ambience := ""
var music_on := true
var _active_music := 0
var _last_gold := 0
var _cooldowns := {} # sound name -> ticks (ms) it was last played, to avoid machine-gun repeats


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for n in SFX_NAMES:
		streams[n] = load(DIR + n + ".wav")
	for n in MUSIC_NAMES + AMBIENCE_NAMES:
		var s: AudioStreamWAV = load(DIR + n + ".wav")
		s.loop_mode = AudioStreamWAV.LOOP_FORWARD
		s.loop_begin = 0
		s.loop_end = s.data.size() / 2 # 16-bit mono
		streams[n] = s
	for i in POOL_SIZE:
		var p := AudioStreamPlayer.new()
		add_child(p)
		pool.append(p)
	for i in 2:
		var m := AudioStreamPlayer.new()
		m.volume_db = -80.0
		add_child(m)
		music_players.append(m)
	ambience_player.volume_db = -80.0
	add_child(ambience_player)
	_last_gold = GameState.gold
	# Every button in the game clicks, and ticks when you move onto it.
	get_tree().node_added.connect(_on_node_added)


func sfx(name: String, pitch_jitter := 0.0, extra_db := 0.0) -> void:
	if not streams.has(name):
		return
	var now := Time.get_ticks_msec()
	if now - int(_cooldowns.get(name, -1000)) < 45:
		return
	_cooldowns[name] = now
	for p in pool:
		if not p.playing:
			p.stream = streams[name]
			p.volume_db = SFX_DB + float(GAIN.get(name, 0.0)) + extra_db
			p.pitch_scale = 1.0 + randf_range(-pitch_jitter, pitch_jitter)
			p.play()
			return


func music(name: String) -> void:
	if name == current_music:
		return
	current_music = name
	var old := music_players[_active_music]
	_active_music = 1 - _active_music
	var fresh := music_players[_active_music]
	if old.playing:
		create_tween().tween_property(old, "volume_db", -80.0, FADE)
	if name == "" or not streams.has(name):
		return
	fresh.stream = streams[name]
	fresh.volume_db = -80.0
	fresh.play()
	create_tween().tween_property(fresh, "volume_db", MUSIC_DB, FADE)
	fresh.set_meta("target_db", MUSIC_DB)


func ambience(name: String) -> void:
	if name == current_ambience:
		return
	current_ambience = name
	if name == "" or not streams.has(name):
		create_tween().tween_property(ambience_player, "volume_db", -80.0, FADE)
		return
	if ambience_player.playing and ambience_player.volume_db > -70.0:
		var tw := create_tween()
		tw.tween_property(ambience_player, "volume_db", -80.0, FADE * 0.5)
		tw.tween_callback(func():
			ambience_player.stream = streams[name]
			ambience_player.play())
		tw.tween_property(ambience_player, "volume_db", AMBIENCE_DB, FADE)
	else:
		ambience_player.stream = streams[name]
		ambience_player.volume_db = -80.0
		ambience_player.play()
		create_tween().tween_property(ambience_player, "volume_db", AMBIENCE_DB, FADE)


# Called when gold is set directly (new game, loading) so it isn't heard as a purchase.
func sync_gold() -> void:
	_last_gold = GameState.gold


func _process(_delta: float) -> void:
	# Gold going up chinks, gold going down is a purchase.
	var g := GameState.gold
	if g != _last_gold:
		if g > _last_gold:
			sfx("coin", 0.05)
		else:
			sfx("buy")
		_last_gold = g


func _input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and not event.echo:
		if event.keycode == KEY_F10:
			AudioServer.set_bus_mute(0, not AudioServer.is_bus_mute(0))
		elif event.keycode == KEY_F11:
			music_on = not music_on
			for m in music_players:
				m.stream_paused = not music_on


func _on_node_added(node: Node) -> void:
	if node is Button:
		var born := Time.get_ticks_msec()
		(node as Button).pressed.connect(func(): sfx("click"))
		(node as Button).mouse_entered.connect(func(): sfx("tick"))
		(node as Button).focus_entered.connect(func():
			# Skip the focus a menu gives its first button as it opens.
			if Time.get_ticks_msec() - born > 250:
				sfx("tick"))
